+void AfeWakeWord::ApplyThreshold() {
+    if (afe_data_ == nullptr) {
+        return;
+    }
+    if (s_threshold_milli > 0) {
+        afe_iface_->set_wakenet_threshold(afe_data_, 1, s_threshold_milli / 1000.0f);
+    } else {
+        afe_iface_->reset_wakenet_threshold(afe_data_, 1);
+    }
+    ESP_LOGI(TAG, "Wake threshold: %d (0: model default)", s_threshold_milli);
+}
+
+bool AfeWakeWord::SetThreshold(int milli) {
+    if (milli != 0 && (milli < 300 || milli > 950)) {
+        return false;
+    }
+    s_threshold_milli = milli;
+    Settings("wake", true).SetInt("threshold", milli);
+    if (s_instance) {
+        s_instance->ApplyThreshold();
+    }
+    return true;
+}
+
+void AfeWakeWord::SetModel(const std::string& name) {
+    Settings("wake", true).SetString("model", name);
+}
